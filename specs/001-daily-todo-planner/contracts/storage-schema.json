{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "daily-todo-planner/planner-document-v1",
  "title": "PlannerDocument v1",
  "description": "Persisted under Capacitor Preferences key `daily-todo-planner`. Mirrors src/shared/models/PlannerDocument.ts.",
  "type": "object",
  "required": ["version", "tasks", "occurrenceStates", "overrides"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/Task" }
    },
    "occurrenceStates": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/OccurrenceKey" },
      "additionalProperties": { "$ref": "#/$defs/OccurrenceState" }
    },
    "overrides": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/OccurrenceKey" },
      "additionalProperties": { "$ref": "#/$defs/OccurrenceOverride" }
    }
  },
  "$defs": {
    "DateKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "TimeKey": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5][05]$" },
    "Uuid": { "type": "string", "format": "uuid" },
    "OccurrenceKey": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}:\\d{4}-\\d{2}-\\d{2}$" },
    "Weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
    "RepeatRule": {
      "oneOf": [
        { "type": "object", "required": ["kind"], "additionalProperties": false, "properties": { "kind": { "const": "none" } } },
        { "type": "object", "required": ["kind"], "additionalProperties": false, "properties": { "kind": { "const": "daily" } } },
        { "type": "object", "required": ["kind"], "additionalProperties": false, "properties": { "kind": { "const": "weekdays" } } },
        {
          "type": "object",
          "required": ["kind", "days"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "weekly" },
            "days": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "$ref": "#/$defs/Weekday" } }
          }
        }
      ]
    },
    "SubItem": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "text": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "Task": {
      "type": "object",
      "required": ["id", "title", "startDate", "time", "repeat", "endDate", "subItems", "createdAt", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "startDate": { "$ref": "#/$defs/DateKey" },
        "time": { "oneOf": [{ "$ref": "#/$defs/TimeKey" }, { "type": "null" }] },
        "repeat": { "$ref": "#/$defs/RepeatRule" },
        "endDate": { "oneOf": [{ "$ref": "#/$defs/DateKey" }, { "type": "null" }] },
        "subItems": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/SubItem" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "OccurrenceState": {
      "type": "object",
      "required": ["done", "doneSubItemIds"],
      "additionalProperties": false,
      "properties": {
        "done": { "type": "boolean" },
        "doneSubItemIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Uuid" } }
      }
    },
    "OccurrenceOverride": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "deleted": { "const": true },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "time": { "oneOf": [{ "$ref": "#/$defs/TimeKey" }, { "type": "null" }] },
        "subItems": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/SubItem" } }
      }
    }
  }
}
